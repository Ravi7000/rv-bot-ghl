REACT_APP_API_URL=http://localhost:3000/api

# Optional: full URL to logo image (overrides default /logo.png from public folder)
# REACT_APP_LOGO_URL=https://example.com/my-logo.png

# Default logo file: put your image at frontend/public/logo.png (same URL on all 3 UI spots: sidebar, top bar, welcome)

# Tech call modal mailto target
# REACT_APP_SUPPORT_EMAIL=support@example.com
