REACT_APP_API_URL=http://localhost:3000/api

# Optional: full URL to your logo (PNG/JPG). Overrides default /logo.png from public folder.
# REACT_APP_LOGO_URL=https://rvjourneygenie.com/wp-content/uploads/.../logo.png

# Default: frontend/public/logo.png — add file, commit, deploy. If PNG fails to load, app falls back to public/logo.svg.

